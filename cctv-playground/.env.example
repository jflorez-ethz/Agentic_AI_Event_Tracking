# Copy this file to .env in the same folder and paste your keys after the = signs.
# .env is listed in .gitignore. Never commit it and never paste keys into a chat.

# Gemini API key from Google AI Studio, created in the project that is linked to your
# paid billing account (the one holding the AI Pro credit). google-genai and Pydantic AI
# both read GOOGLE_API_KEY. Do not also set GEMINI_API_KEY.
GOOGLE_API_KEY=

# Claude API key created in the "security-augmented" workspace (monthly limit $40).
ANTHROPIC_API_KEY=
